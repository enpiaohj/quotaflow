<Window x:Class="QuotaFlow.Windows.App.Views.MainPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuotaFlow.Windows.App.Converters"
        xmlns:vm="clr-namespace:QuotaFlow.Windows.App.ViewModels"
        Title="QuotaFlow"
        Width="420" Height="560" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:StatusKindToBrushConverter x:Key="StatusKindToBrush" />

        <Style x:Key="Style.RefreshButton" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="CardSpin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                  From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="CardSpin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProviderCardTemplate" DataType="{x:Type vm:ProviderCardViewModel}">
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,8" Visibility="{Binding Visibility}">
                <StackPanel>
                    <!-- 卡片头部：状态点 + 名称 + 状态文案 + 排序箭头 + 展开按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Style.CardTitleText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />

                        <!-- 卡片顺序：直接在面板上调整，点击即时生效并持久化，不用去设置页。
                             首位禁用"上移"、末位禁用"下移"（Style.IconButton 自带禁用变暗）。 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Button Content="&#9650;" FontSize="7" Width="16" Height="13" Padding="0"
                                    Style="{StaticResource Style.IconButton}"
                                    AutomationProperties.AutomationId="{Binding ProviderId, StringFormat=CardMoveUp_{0}}"
                                    Command="{Binding DataContext.MoveCardUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="上移" />
                            <Button Content="&#9660;" FontSize="7" Width="16" Height="13" Padding="0" Margin="0,1,0,0"
                                    Style="{StaticResource Style.IconButton}"
                                    AutomationProperties.AutomationId="{Binding ProviderId, StringFormat=CardMoveDown_{0}}"
                                    Command="{Binding DataContext.MoveCardDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="下移" />
                        </StackPanel>

                        <Button Grid.Column="3" Style="{StaticResource Style.IconButton}" Command="{Binding ToggleExpandCommand}"
                                Content="&#8943;" FontSize="16" ToolTip="展开/收起详情" />
                    </Grid>

                    <!-- 引导文案：未配置/需要重新登录/网络异常等 -->
                    <TextBlock Text="{Binding UserGuidance}" TextWrapping="Wrap" Margin="0,6,0,0"
                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding UserGuidance, Converter={StaticResource NotEmptyToVis}}" />

                    <!-- 余额型卡片（DeepSeek） -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,8,0,2"
                                Visibility="{Binding HasBalance, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding BalanceCurrencyText}" VerticalAlignment="Bottom" Margin="0,0,4,3"
                                       FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{Binding BalanceAmountText}" Style="{StaticResource Style.BalanceAmountText}" />
                        </StackPanel>
                        <TextBlock Text="可用余额" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding BalanceDetailText}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 额度窗口型卡片（Claude/Codex/MiniMax，及自定义平台）。v1.1.0 起与余额区块
                         各自独立可见（HasWindows / HasBalance），不再互斥——自定义平台理论上可以
                         同时有若干个百分比窗口和一个余额窗口。 -->
                    <ItemsControl ItemsSource="{Binding Windows}" Margin="0,6,0,0"
                                  Visibility="{Binding HasWindows, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuotaWindowViewModel}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                                               Style="{StaticResource Style.WindowLabelText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />

                                    <!-- 正常态：进度条 + 百分比（都按 DisplaySemantic 显示已用/剩余，
                                         条的填充量和旁边的数字必须是同一个值，否则切换时数字变了
                                         条不变，看起来像没生效） -->
                                    <ProgressBar Grid.Row="0" Grid.Column="1" Margin="8,0"
                                                 Value="{Binding DisplayPercent, Mode=OneWay}"
                                                 Style="{StaticResource Style.QuotaProgressBar}"
                                                 Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PercentText}"
                                               Style="{StaticResource Style.PercentText}" VerticalAlignment="Center"
                                               Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVis}}" />

                                    <!-- 错误态：单个窗口取值失败，只在这一行显示"数据不可用"，不拿占位 0% 冒充数据，
                                         也不影响同一张卡片里其它窗口的正常渲染。 -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0"
                                               Text="数据不可用" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               ToolTip="{Binding ErrorMessage}"
                                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,1,0,0"
                                               Text="{Binding ResetHintText}" Style="{StaticResource Style.ResetHintText}"
                                               Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 展开后的诊断信息 -->
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,0,0,0">
                        <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DataSource, StringFormat=数据来源：{0}}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </StackPanel>

                    <!-- 底部：更新时间 + 单卡刷新 -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LastUpdatedText}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                        <Button Grid.Column="1" Width="22" Height="22" FontSize="13" Content="&#8635;"
                                Style="{StaticResource Style.RefreshButton}" Command="{Binding RefreshCommand}"
                                ToolTip="刷新此平台" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Style="{StaticResource Style.PanelShell}">
        <DockPanel Margin="16,14,16,12">
            <!-- 顶部区域 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Style.TitleText}">
                    <Run Text="QuotaFlow" />
                    <Run Text=" " />
                    <Run Text="{Binding VersionText, Mode=OneWay}" FontSize="11" FontWeight="Normal"
                         Foreground="{DynamicResource Brush.TextTertiary}" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="AI 额度状态" Style="{StaticResource Style.SubtitleText}" Margin="0,2,0,0" />

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <!-- 已用/剩余显示语义：点击切换，立即生效并持久化，纯展示层，不触发任何刷新。 -->
                    <Button Content="{Binding DisplaySemanticLabel}" Command="{Binding ToggleDisplaySemanticCommand}"
                            AutomationProperties.AutomationId="ToggleDisplaySemanticButton"
                            ToolTip="切换显示已用/剩余百分比" FontSize="11" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="8,2" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Style.IconButton}" Content="&#9881;" FontSize="14"
                            AutomationProperties.AutomationId="SettingsButton"
                            Click="OnOpenSettingsClick" ToolTip="设置" Margin="0,0,4,0" />
                    <Button DataContext="{Binding}" Content="&#8635;" FontSize="15"
                            Command="{Binding RefreshAllCommand}" ToolTip="刷新全部">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshingAll}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="HeaderSpin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                      From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="HeaderSpin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HeaderLastUpdatedText}"
                           Style="{StaticResource Style.SubtitleText}" Margin="0,2,0,0" HorizontalAlignment="Right" />

                <!-- 实时日期/时间：格式由设置"日期显示格式"决定，每秒刷新。 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ClockText}"
                           FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,3,0,0" />
            </Grid>

            <!-- 平台卡片：顺序按设置（PlatformOrder），未配置的平台自动隐藏；全部未配置时显示引导文案 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ProviderCardTemplate}" />

                    <!-- 空态：所有平台都还没配置凭据/登录，友好引导而不是假装有数据 -->
                    <Border Style="{StaticResource Style.Card}" Visibility="{Binding EmptyStateVisibility}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="还没有可显示的额度" Style="{StaticResource Style.CardTitleText}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="尚未配置任何平台的凭据。"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="点击右上角 ⚙ 打开设置：Claude/Codex 直接用对应 CLI 登录，MiniMax/DeepSeek 在各自分组填写 API Key。配置完成后，额度会自动显示在面板上。"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
