<Window x:Class="QuotaFlow.Windows.App.Views.MainPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuotaFlow.Windows.App.Converters"
        xmlns:vm="clr-namespace:QuotaFlow.Windows.App.ViewModels"
        Title="QuotaFlow"
        Width="420" Height="560" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:StatusKindToBrushConverter x:Key="StatusKindToBrush" />

        <Style x:Key="Style.RefreshButton" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="CardSpin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                  From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="CardSpin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProviderCardTemplate" DataType="{x:Type vm:ProviderCardViewModel}">
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,8">
                <StackPanel>
                    <!-- 卡片头部：状态点 + 名称 + 状态文案 + 展开按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Style.CardTitleText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                        <Button Grid.Column="2" Style="{StaticResource Style.IconButton}" Command="{Binding ToggleExpandCommand}"
                                Content="&#8943;" FontSize="16" ToolTip="展开/收起详情" />
                    </Grid>

                    <!-- 引导文案：未配置/需要重新登录/网络异常等 -->
                    <TextBlock Text="{Binding UserGuidance}" TextWrapping="Wrap" Margin="0,6,0,0"
                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding UserGuidance, Converter={StaticResource NotEmptyToVis}}" />

                    <!-- 余额型卡片（DeepSeek） -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,8,0,2"
                                Visibility="{Binding HasBalance, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding BalanceCurrencyText}" VerticalAlignment="Bottom" Margin="0,0,4,3"
                                       FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{Binding BalanceAmountText}" Style="{StaticResource Style.BalanceAmountText}" />
                        </StackPanel>
                        <TextBlock Text="可用余额" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding BalanceDetailText}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 额度窗口型卡片（Claude/Codex/MiniMax） -->
                    <ItemsControl ItemsSource="{Binding Windows}" Margin="0,6,0,0"
                                  Visibility="{Binding HasBalance, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuotaWindowViewModel}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                                               Style="{StaticResource Style.WindowLabelText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                    <ProgressBar Grid.Row="0" Grid.Column="1" Margin="8,0"
                                                 Value="{Binding RemainingPercent, Mode=OneWay}"
                                                 Style="{StaticResource Style.QuotaProgressBar}"
                                                 Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PercentText}"
                                               Style="{StaticResource Style.PercentText}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,1,0,0"
                                               Text="{Binding ResetHintText}" Style="{StaticResource Style.ResetHintText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 展开后的诊断信息 -->
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,0,0,0">
                        <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DataSource, StringFormat=数据来源：{0}}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </StackPanel>

                    <!-- 底部：更新时间 + 单卡刷新 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LastUpdatedText}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                        <Button Grid.Column="1" Width="22" Height="22" FontSize="13" Content="&#8635;"
                                Style="{StaticResource Style.RefreshButton}" Command="{Binding RefreshCommand}"
                                ToolTip="刷新此平台" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Style="{StaticResource Style.PanelShell}">
        <DockPanel Margin="16,14,16,12">
            <!-- 顶部区域 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="QuotaFlow" Style="{StaticResource Style.TitleText}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="AI 额度状态" Style="{StaticResource Style.SubtitleText}" Margin="0,2,0,0" />

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Style.IconButton}" Content="&#9881;" FontSize="14"
                            Click="OnOpenSettingsClick" ToolTip="设置" Margin="0,0,4,0" />
                    <Button DataContext="{Binding}" Content="&#8635;" FontSize="15"
                            Command="{Binding RefreshAllCommand}" ToolTip="刷新全部">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshingAll}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="HeaderSpin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                      From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="HeaderSpin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HeaderLastUpdatedText}"
                           Style="{StaticResource Style.SubtitleText}" Margin="0,2,0,0" HorizontalAlignment="Right" />
            </Grid>

            <!-- 四张平台卡片，固定顺序 Claude/Codex/MiniMax/DeepSeek，尽量不滚动即可看完 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ProviderCardTemplate}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
