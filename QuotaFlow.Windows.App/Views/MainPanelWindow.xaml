<Window x:Class="QuotaFlow.Windows.App.Views.MainPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuotaFlow.Windows.App.Converters"
        xmlns:vm="clr-namespace:QuotaFlow.Windows.App.ViewModels"
        Title="QuotaFlow"
        Width="420" Height="560" MinHeight="120" MinWidth="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:StatusKindToBrushConverter x:Key="StatusKindToBrush" />

        <Style x:Key="Style.RefreshButton" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="CardSpin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                  From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="CardSpin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 紧凑布局（设置页/桌面看板模式默认开启）：卡片内边距收窄，不重排字段——
             文档要求"标准/紧凑"共用同一套数据模板，只改间距密度，不是两套完全独立的 UI。 -->
        <Style x:Key="Style.Card.Compactable" TargetType="Border" BasedOn="{StaticResource Style.Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="10,7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProviderCardTemplate" DataType="{x:Type vm:ProviderCardViewModel}">
            <Border Style="{StaticResource Style.Card.Compactable}" Margin="0,0,0,8" Visibility="{Binding Visibility}">
                <StackPanel>
                    <!-- 卡片头部：状态点 + 名称 + 状态文案 + 排序箭头 + 展开按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Style.CardTitleText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />

                        <!-- 卡片顺序：直接在面板上调整，点击即时生效并持久化，不用去设置页。
                             首位禁用"上移"、末位禁用"下移"（Style.IconButton 自带禁用变暗）。 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Button Content="&#9650;" FontSize="7" Width="16" Height="13" Padding="0"
                                    Style="{StaticResource Style.IconButton}"
                                    AutomationProperties.AutomationId="{Binding ProviderId, StringFormat=CardMoveUp_{0}}"
                                    Command="{Binding DataContext.MoveCardUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="上移" />
                            <Button Content="&#9660;" FontSize="7" Width="16" Height="13" Padding="0" Margin="0,1,0,0"
                                    Style="{StaticResource Style.IconButton}"
                                    AutomationProperties.AutomationId="{Binding ProviderId, StringFormat=CardMoveDown_{0}}"
                                    Command="{Binding DataContext.MoveCardDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="下移" />
                        </StackPanel>

                        <Button Grid.Column="3" Style="{StaticResource Style.IconButton}" Command="{Binding ToggleExpandCommand}"
                                Content="&#8943;" FontSize="16" ToolTip="展开/收起详情" />
                    </Grid>

                    <!-- 引导文案：未配置/需要重新登录/网络异常等 -->
                    <TextBlock Text="{Binding UserGuidance}" TextWrapping="Wrap" Margin="0,6,0,0"
                               FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding UserGuidance, Converter={StaticResource NotEmptyToVis}}" />

                    <!-- 余额型卡片（DeepSeek） -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,8,0,2"
                                Visibility="{Binding HasBalance, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding BalanceCurrencyText}" VerticalAlignment="Bottom" Margin="0,0,4,3"
                                       FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{Binding BalanceAmountText}" Style="{StaticResource Style.BalanceAmountText}" />
                        </StackPanel>
                        <TextBlock Text="可用余额" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding BalanceDetailText}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 额度窗口型卡片（Claude/Codex/MiniMax，及自定义平台）。v1.1.0 起与余额区块
                         各自独立可见（HasWindows / HasBalance），不再互斥——自定义平台理论上可以
                         同时有若干个百分比窗口和一个余额窗口。 -->
                    <ItemsControl ItemsSource="{Binding Windows}" Margin="0,6,0,0"
                                  Visibility="{Binding HasWindows, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuotaWindowViewModel}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                                               Style="{StaticResource Style.WindowLabelText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />

                                    <!-- 正常态：进度条 + 百分比（都按 DisplaySemantic 显示已用/剩余，
                                         条的填充量和旁边的数字必须是同一个值，否则切换时数字变了
                                         条不变，看起来像没生效） -->
                                    <ProgressBar Grid.Row="0" Grid.Column="1" Margin="8,0"
                                                 Value="{Binding DisplayPercent, Mode=OneWay}"
                                                 Style="{StaticResource Style.QuotaProgressBar}"
                                                 Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PercentText}"
                                               Style="{StaticResource Style.PercentText}" VerticalAlignment="Center"
                                               Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVis}}" />

                                    <!-- 错误态：单个窗口取值失败，只在这一行显示"数据不可用"，不拿占位 0% 冒充数据，
                                         也不影响同一张卡片里其它窗口的正常渲染。 -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0"
                                               Text="数据不可用" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               ToolTip="{Binding ErrorMessage}"
                                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,1,0,0"
                                               Text="{Binding ResetHintText}" Style="{StaticResource Style.ResetHintText}"
                                               Visibility="{Binding IsError, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 展开后的诊断信息 -->
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,0,0,0">
                        <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding DataSource, StringFormat=数据来源：{0}}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </StackPanel>

                    <!-- 底部：更新时间 + 单卡刷新 -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LastUpdatedText}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                        <Button Grid.Column="1" Width="22" Height="22" FontSize="13" Content="&#8635;"
                                Style="{StaticResource Style.RefreshButton}" Command="{Binding RefreshCommand}"
                                ToolTip="刷新此平台" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ==================== 桌面看板紧凑行（独立视觉树，不复用上面的 ProviderCardTemplate）====================
             ItemsSource 仍然绑定同一个 Cards 集合（同一份数据源、同一套排序/可见性规则），只是
             DataTemplate 换成完全不同的、扁平化的一行——数据取自 ProviderCardViewModel.Compact
             这个只读适配层（CompactProviderRowViewModel），不重新解析任何 Provider 数据。 -->
        <Style x:Key="Style.CompactToolbarButton" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <DataTemplate x:Key="CompactProviderRowTemplate" DataType="{x:Type vm:ProviderCardViewModel}">
            <Border Visibility="{Binding Visibility}" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Brush.Divider}" Padding="2,5" MinHeight="42">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="刷新此平台" Command="{Binding Compact.RefreshCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Ellipse Grid.Row="0" Grid.Column="0" Width="7" Height="7" Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{Binding Compact.StatusKind, Converter={StaticResource StatusKindToBrush}}"
                             ToolTip="{Binding Compact.DetailsTooltip}" />

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextPrimary}" ToolTip="{Binding DisplayName}" />

                    <!-- 额度窗口型（Claude/Codex/MiniMax）：主窗口% + 次窗口%，不铺满整行的进度条——
                         百分比数字是第一视觉层，这里不放条（文档 §7.1）。 -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding Compact.IsWindowRow, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Compact.PrimaryWindow.PercentText}" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   Foreground="{Binding Compact.PrimaryWindow.StatusKind, Converter={StaticResource StatusKindToBrush}}"
                                   ToolTip="{Binding Compact.PrimaryWindow.DisplayName}"
                                   Visibility="{Binding Compact.HasPrimary, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Compact.SecondaryWindow.PercentText}" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Font.Numeric}" Margin="10,0,0,0"
                                   Foreground="{Binding Compact.SecondaryWindow.StatusKind, Converter={StaticResource StatusKindToBrush}}"
                                   ToolTip="{Binding Compact.SecondaryWindow.DisplayName}"
                                   Visibility="{Binding Compact.HasSecondary, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 余额型（DeepSeek）：币种 + 金额，不伪造 5h/7d 进度条（文档 §7.2）。 -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding Compact.IsBalanceRow, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Compact.BalanceCurrencyText}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,3,1"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding Compact.BalanceAmountText}" FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </StackPanel>

                    <!-- 额外窗口折叠为 +N，悬停/点击展开详情浮层（文档 §8）。 -->
                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}"
                               Text="{Binding Compact.ExtraWindowCount, StringFormat=+{0}}"
                               ToolTip="{Binding Compact.DetailsTooltip}"
                               Visibility="{Binding Compact.HasExtraWindows, Converter={StaticResource BoolToVis}}" />

                    <!-- 状态文案：点名具体是哪个窗口异常（"5 小时额度告急"/"周额度偏低"……），
                         而不是笼统的"紧张"；正常时不显示文字，只靠左侧状态点表达（文档 §9）。 -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0"
                               FontSize="10" TextTrimming="CharacterEllipsis"
                               Text="{Binding Compact.StatusText}"
                               Foreground="{Binding Compact.StatusKind, Converter={StaticResource StatusKindToBrush}}"
                               ToolTip="{Binding Compact.DetailsTooltip}"
                               Visibility="{Binding Compact.StatusText, Converter={StaticResource NotEmptyToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 背景层：独立于内容层的不透明度，"显示模式"里的透明度设置只淡化这一层
             （背景色/边框/阴影），文字/图标/进度条所在的内容层永远保持 Opacity=1，
             不会因为背景变淡而跟着变得难以辨认（文档 §8.2）。 -->
        <Border x:Name="PanelBackgroundLayer" Style="{StaticResource Style.PanelShell}" />

        <DockPanel Margin="16,14,16,12"
                   Visibility="{Binding IsDesktopPanelMode, Converter={StaticResource InverseBoolToVis}}">
            <!-- 顶部区域：整块区域是拖动手柄（悬浮/桌面看板模式下 IsDraggable=true 时生效），
                 按钮位于其上层，Button 会在 MouseLeftButtonDown 时自行标记 Handled，
                 点击按钮不会触发拖动。 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Style.TitleText}">
                    <Run Text="QuotaFlow" />
                    <Run Text=" " />
                    <Run Text="{Binding VersionText, Mode=OneWay}" FontSize="11" FontWeight="Normal"
                         Foreground="{DynamicResource Brush.TextTertiary}" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="AI 额度状态" Style="{StaticResource Style.SubtitleText}" Margin="0,2,0,0" />

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <!-- 显示模式：托盘弹出 → 悬浮 → 桌面看板 → 托盘弹出，循环切换；图标随当前模式变化，
                         Tooltip 说明点击后会切到哪个模式。更细的每模式设置（置顶/锁定位置/透明度/
                         材质/紧凑布局）在设置页"显示与窗口"里调。 -->
                    <Button Content="{Binding ModeGlyph}" FontSize="13" Command="{Binding CycleDisplayModeCommand}"
                            AutomationProperties.AutomationId="CycleDisplayModeButton"
                            ToolTip="{Binding ModeTooltip}" Margin="0,0,4,0"
                            Style="{StaticResource Style.IconButton}" />
                    <!-- 固定面板：固定后点击面板外部不再自动收起，方便一边看额度一边操作其它窗口。
                         托盘图标单击/双击/Esc 依然能正常关闭，固定只挡"点外部失焦"这一种收起方式。 -->
                    <Button Content="&#128204;" FontSize="12" Command="{Binding TogglePinCommand}"
                            AutomationProperties.AutomationId="TogglePinButton"
                            ToolTip="固定面板（固定后点击外部不收起）" Margin="0,0,4,0">
                        <Button.Style>
                            <!-- Style.IconButton 的模板把背景硬写成 Transparent（不绑 TemplateBinding），
                                 外部设 Background 不会有任何视觉效果；Foreground 是继承属性，能穿透
                                 自动生成的 ContentPresenter 影响到图标本身的颜色，所以用变色而不是变底色
                                 来表达"已固定"状态。 -->
                            <Style TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDeepSeek}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 已用/剩余显示语义：点击切换，立即生效并持久化，纯展示层，不触发任何刷新。 -->
                    <Button Content="{Binding DisplaySemanticLabel}" Command="{Binding ToggleDisplaySemanticCommand}"
                            AutomationProperties.AutomationId="ToggleDisplaySemanticButton"
                            ToolTip="切换显示已用/剩余百分比" FontSize="11" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Padding" Value="8,2" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Style.IconButton}" Content="&#9881;" FontSize="14"
                            AutomationProperties.AutomationId="SettingsButton"
                            Click="OnOpenSettingsClick" ToolTip="设置" Margin="0,0,4,0" />
                    <Button DataContext="{Binding}" Content="&#8635;" FontSize="15"
                            Command="{Binding RefreshAllCommand}" ToolTip="刷新全部">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshingAll}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="HeaderSpin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                      From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="HeaderSpin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HeaderLastUpdatedText}"
                           Style="{StaticResource Style.SubtitleText}" Margin="0,2,0,0" HorizontalAlignment="Right" />

                <!-- 实时日期/时间：格式由设置"日期显示格式"决定，每秒刷新。 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ClockText}"
                           FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,3,0,0" />
            </Grid>

            <!-- 平台卡片：顺序按设置（PlatformOrder），未配置的平台自动隐藏；全部未配置时显示引导文案 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ProviderCardTemplate}" />

                    <!-- 空态：所有平台都还没配置凭据/登录，友好引导而不是假装有数据 -->
                    <Border Style="{StaticResource Style.Card}" Visibility="{Binding EmptyStateVisibility}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="还没有可显示的额度" Style="{StaticResource Style.CardTitleText}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="尚未配置任何平台的凭据。"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="点击右上角 ⚙ 打开设置：Claude/Codex 直接用对应 CLI 登录，MiniMax/DeepSeek 在各自分组填写 API Key。配置完成后，额度会自动显示在面板上。"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ==================== 桌面看板：独立紧凑视觉树（文档 §4） ====================
             不复用上面标准视图的任何元素——顶部只保留产品名+紧凑更新时间，四个平台用扁平行，
             默认不出现滚动条，工具栏常态透明、鼠标移入后淡入。 -->
        <DockPanel Margin="12,8,12,8"
                   Visibility="{Binding IsDesktopPanelMode, Converter={StaticResource BoolToVis}}">
            <!-- DesktopPanelHeader：QuotaFlow + 紧凑更新时间；同一块区域仍然是拖动手柄。 -->
            <Grid x:Name="DesktopPanelHeader" DockPanel.Dock="Top" Height="28" Margin="0,0,0,6"
                  Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="QuotaFlow" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                           ToolTip="{Binding VersionText}" />

                <!-- 常态：紧凑更新时间（"刚刚 / 5 分钟前 / 数据过期"）。 -->
                <TextBlock x:Name="CompactHeaderTimeBlock" Grid.Column="1" VerticalAlignment="Center"
                           Text="{Binding CompactHeaderTimeText}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           ToolTip="{Binding HeaderLastUpdatedText}" />

                <!-- 悬停工具栏：与上面的时间文案叠在同一个格子里，常态 Opacity=0 且不接受鼠标点击
                     （IsHitTestVisible=False 只挡鼠标，键盘 Tab 仍能对焦到里面的按钮——文档 §16
                     "隐藏工具栏不能让键盘用户无法退出桌面看板"）。淡入淡出由 MainPanelWindow.xaml.cs
                     跟随整个窗口的 MouseEnter/MouseLeave 驱动，尊重 Windows"减少动画"设置。 -->
                <StackPanel x:Name="HoverToolbar" Grid.Column="1" Orientation="Horizontal"
                            Opacity="0" IsHitTestVisible="False" Background="{DynamicResource Brush.PanelBackground}">
                    <Button Style="{StaticResource Style.CompactToolbarButton}" Content="&#8635;" ToolTip="刷新全部"
                            AutomationProperties.AutomationId="CompactRefreshAllButton"
                            Command="{Binding RefreshAllCommand}" />
                    <Button Content="&#128280;" ToolTip="始终置顶"
                            AutomationProperties.AutomationId="CompactAlwaysOnTopButton"
                            Command="{Binding ToggleAlwaysOnTopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.CompactToolbarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDeepSeek}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button AutomationProperties.AutomationId="CompactPositionLockButton"
                            Command="{Binding TogglePositionLockedCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.CompactToolbarButton}">
                                <Setter Property="Content" Value="&#128275;" />
                                <Setter Property="ToolTip" Value="位置锁定（已解锁，点击锁定）" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPositionLocked}" Value="True">
                                        <Setter Property="Content" Value="&#128274;" />
                                        <Setter Property="ToolTip" Value="位置已锁定，点击解锁" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDeepSeek}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Style.CompactToolbarButton}" Content="{Binding ModeGlyph}"
                            ToolTip="{Binding ModeTooltip}"
                            AutomationProperties.AutomationId="CompactCycleModeButton"
                            Command="{Binding CycleDisplayModeCommand}" />
                    <Button Style="{StaticResource Style.CompactToolbarButton}" Content="&#8943;" ToolTip="更多"
                            AutomationProperties.AutomationId="CompactMoreMenuButton"
                            Click="OnCompactMoreMenuClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开设置" Click="OnOpenSettingsClick" />
                                <MenuItem Header="恢复默认窗口位置" Command="{Binding RestoreDefaultPositionCommand}" />
                                <MenuItem Header="切换标准/紧凑布局" Command="{Binding ToggleCompactLayoutCommand}" />
                                <Separator />
                                <MenuItem Header="退出桌面看板（切回悬浮窗口）" Command="{Binding ExitDesktopPanelCommand}" />
                                <MenuItem Header="退出应用" Command="{Binding ExitCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CompactProviderList：默认不出现滚动条，只有平台数量超出设计容量等极端情况才会出现
                 （文档 §11，Auto 在内容未溢出时不占宽度、不显示滚动条本身）。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CompactProviderRowTemplate}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
