<Window x:Class="QuotaFlow.Windows.App.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuotaFlow" Width="460" SizeToContent="Height"
        Background="{DynamicResource Brush.Background}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,18">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextPrimary}" />
        <TextBlock x:Name="HintText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}" />

        <TextBlock Text="口令" FontSize="12" Margin="0,16,0,6"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <PasswordBox x:Name="PasswordInput" Padding="8,6" FontSize="13"
                     AutomationProperties.AutomationId="BackupPasswordBox"
                     PasswordChanged="OnPasswordChanged" />

        <!-- 导出时需要二次确认，避免打错字导致备份包永远打不开（我们不保存口令，找不回来）。 -->
        <StackPanel x:Name="ConfirmSection" Visibility="Collapsed">
            <TextBlock Text="再次输入以确认" FontSize="12" Margin="0,12,0,6"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <PasswordBox x:Name="ConfirmInput" Padding="8,6" FontSize="13"
                         AutomationProperties.AutomationId="BackupPasswordConfirmBox"
                         PasswordChanged="OnPasswordChanged" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.StatusBad}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="确定" Style="{StaticResource Style.PrimaryButton}"
                    MinWidth="88" Margin="0,0,8,0" IsDefault="True" IsEnabled="False"
                    AutomationProperties.AutomationId="BackupPasswordOkButton"
                    Click="OnOkClick" />
            <Button Content="取消" Style="{StaticResource Style.SecondaryButton}" MinWidth="88"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
