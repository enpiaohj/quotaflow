<Window x:Class="QuotaFlow.Windows.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuotaFlow.Windows.App.Converters"
        xmlns:vm="clr-namespace:QuotaFlow.Windows.App.ViewModels"
        Title="QuotaFlow 设置" Width="840" Height="660" MinWidth="720" MinHeight="520"
        Background="{DynamicResource Brush.Background}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- RadioButton 用全局隐式样式（Themes/Styles.xaml），这里不再局部覆盖——局部同类型
             无 Key 样式会盖掉全局模板，之前只设了 Margin/Foreground，等于让深色模式下的单选框
             一直用系统默认的白底控件外观。 -->
        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Divider}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- BasedOn 全局 TextBox 隐式样式（Themes/Styles.xaml）：继承深色/浅色都对的背景、
             文字色和聚焦态模板，这里只再叠加各自的间距/字体差异，不用重新定义一整套外观。 -->
        <Style x:Key="EndpointBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="SecretInputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <!-- 右侧留出 34px 给叠加的"眼睛"按钮 -->
            <Setter Property="Padding" Value="8,6,34,6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <!-- API Key 只会是 ASCII 字符，禁用输入法：既不需要中文候选框，也避免第三方 IME 钩子冲突。 -->
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
        </Style>

        <!-- ========== 左侧分类导航 ==========
             用 TabControl(TabStripPlacement=Left) 而不是自建 ListBox + 可见性绑定：分类切换
             属于纯视图状态，交给控件自身管理，ViewModel 不需要为"当前在哪一页"新增任何属性。 -->
        <Style x:Key="Style.NavTabs" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Brush.PanelBackground}"
                                    BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,0,1,0">
                                <TabPanel IsItemsHost="True" Margin="0,10" VerticalAlignment="Top" />
                            </Border>
                            <!-- 名字必须是 PART_SelectedContentHost：TabControl 按这个名字定位
                                 内容宿主，改名或漏掉会导致左侧分类正常、右侧内容整片空白
                                 （编译与 XAML 解析都不会报错）。 -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.NavItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="8,1" Padding="12,9"
                                Background="Transparent">
                            <ContentPresenter x:Name="Label" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.FontSize="13"
                                              TextElement.Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Divider}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground"
                                        Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类页标题：每页顶部一个大标题，替代原来每张卡片都重复一遍小标题。 -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- ========== 可折叠区块 ==========
             平台卡片默认收起，只露出"名称 + 状态"，展开才显示配置项。同一个模板也用于卡片内的
             「高级」段（接口地址覆盖）。同样不需要 ViewModel 记录展开状态。 -->
        <Style x:Key="Style.Collapsible" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- 标题必须是 ToggleButton 并把 IsChecked 双向绑到 IsExpanded：
                                 Expander 的展开行为完全来自模板里的这个 ToggleButton，只画一个
                                 Border 是点不动的（编译能过、运行时静默失效），也不会暴露给
                                 UI 自动化和键盘操作。 -->
                            <ToggleButton Content="{TemplateBinding Header}" Cursor="Hand"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron" Text="&#9656;" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#9662;" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground"
                                                        Value="{DynamicResource Brush.TextPrimary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="16,10,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「高级」折叠段的标题文字，比平台名弱一级。 -->
        <Style x:Key="AdvancedLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 固定底部：保存按钮 + 状态文案，始终可见，不用滚到最下面才能保存。 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <!-- 状态文案在左、保存按钮在右：840px 宽度下按钮不再拉通整行。
                 「显示与窗口」页是即时生效的，该页顶部已单独说明，这里不再重复。 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="4,0,16,0"
                           AutomationProperties.AutomationId="StatusMessageText"
                           FontSize="12" Foreground="{DynamicResource Brush.AccentDeepSeek}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="保存设置" Style="{StaticResource Style.PrimaryButton}"
                        MinWidth="120"
                        AutomationProperties.AutomationId="SaveSettingsButton"
                        Command="{Binding SaveGeneralSettingsCommand}" />
            </Grid>
        </Border>

        <TabControl Style="{StaticResource Style.NavTabs}" ItemContainerStyle="{StaticResource Style.NavItem}">

        <!-- ==================== 常规 ==================== -->
        <TabItem Header="常规">
        <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="常规" Style="{StaticResource PageTitle}" />

            <!-- 刷新 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="刷新" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自动刷新间隔" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" Width="120" ItemsSource="{Binding AllowedRefreshIntervals}"
                                  SelectedItem="{Binding AutoRefreshIntervalMinutes}" />
                    </Grid>
                    <CheckBox Content="启动时立即刷新" IsChecked="{Binding RefreshOnStartup}" />
                </StackPanel>
            </Border>

            <!-- 网络代理 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="网络代理" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="ProxyMode" Content="跟随系统"
                                     AutomationProperties.AutomationId="ProxyModeRadio_System"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        <RadioButton GroupName="ProxyMode" Content="直连"
                                     AutomationProperties.AutomationId="ProxyModeRadio_Direct"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumEquals}, ConverterParameter=Direct}" />
                        <RadioButton GroupName="ProxyMode" Content="自定义"
                                     AutomationProperties.AutomationId="ProxyModeRadio_Custom"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}" />
                    </StackPanel>
                    <TextBox Style="{StaticResource EndpointBox}"
                             AutomationProperties.AutomationId="ProxyAddressBox"
                             Visibility="{Binding CustomProxyVisibility}"
                             Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如 http://127.0.0.1:7890，也可只填 127.0.0.1:7890" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="「跟随系统」是默认行为：优先读 HTTP_PROXY / HTTPS_PROXY 环境变量，没有才用系统代理设置。若浏览器上网正常、本应用却所有平台都提示网络失败，多半是环境变量里残留了失效的代理地址——改成「直连」即可，保存后立即生效。" />
                </StackPanel>
            </Border>

            <!-- 启动 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="开机自动启动（默认关闭）" IsChecked="{Binding StartWithWindows}"
                              AutomationProperties.AutomationId="StartWithWindowsCheckBox" />
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        </TabItem>

        <!-- ==================== 外观 ==================== -->
        <TabItem Header="外观">
        <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="外观" Style="{StaticResource PageTitle}" />

            <!-- 外观 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Theme" Content="跟随系统"
                                     AutomationProperties.AutomationId="ThemeRadio_System"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        <RadioButton GroupName="Theme" Content="浅色"
                                     AutomationProperties.AutomationId="ThemeRadio_Light"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                        <RadioButton GroupName="Theme" Content="深色"
                                     AutomationProperties.AutomationId="ThemeRadio_Dark"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                    </StackPanel>
                    <TextBlock Text="日期显示格式" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ClockDisplayFormatOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Format"
                              SelectedValue="{Binding ClockDisplayFormat}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="下拉中的每个选项都展示该格式的实时效果，选项含义一目了然，选中后立即应用到面板顶部的时钟。" />
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        </TabItem>

        <!-- ==================== 平台与账号 ==================== -->
        <TabItem Header="平台与账号">
        <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="平台与账号" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource StatusLabel}" Margin="0,-10,0,14" TextWrapping="Wrap"
                       Text="点击平台名称展开配置。密钥与登录态只保存在 Windows 凭据管理器，不写入配置文件、日志或缓存。" />

            <!-- 额度窗口显示 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="额度窗口显示" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="显示未识别的新额度窗口（默认关闭）" IsChecked="{Binding ShowUnknownWindows}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="服务端偶尔会新增尚未识别的额度窗口（例如 nimbus_quill）。默认隐藏，不占面板空间；开启后这类窗口会以中文标签显示出来，便于观察。" />
                </StackPanel>
            </Border>

            <!-- Claude -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,10">
                <Expander Style="{StaticResource Style.Collapsible}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Claude" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <CheckBox Grid.Column="1" Content="显示" Margin="0,0,14,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ShowClaudeOnPanelCheckBox"
                                      ToolTip="取消勾选后该平台不在面板上显示（配置和数据都保留）"
                                      IsChecked="{Binding ShowClaudeOnPanel}" />
                            <TextBlock Grid.Column="2" Text="{Binding ClaudeLoginStatusText}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="不提供密码输入框——请直接使用 Claude Code CLI 完成登录。"
                                   Style="{StaticResource StatusLabel}" Margin="0,0,0,0" TextWrapping="Wrap" />
                        <Button Content="重新检测登录状态" Style="{StaticResource Style.SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding RefreshLoginStatusCommand}" />
                        <Expander Style="{StaticResource Style.Collapsible}" Margin="0,12,0,0">
                            <Expander.Header>
                                <TextBlock Text="高级" Style="{StaticResource AdvancedLabel}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="接口地址（留空使用默认）" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource EndpointBox}" Text="{Binding ClaudeEndpointOverride}" />
                                <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                           Text="{Binding EffectiveClaudeUrl, StringFormat=当前使用：{0}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- Codex -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,10">
                <Expander Style="{StaticResource Style.Collapsible}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Codex" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <CheckBox Grid.Column="1" Content="显示" Margin="0,0,14,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ShowCodexOnPanelCheckBox"
                                      ToolTip="取消勾选后该平台不在面板上显示（配置和数据都保留）"
                                      IsChecked="{Binding ShowCodexOnPanel}" />
                            <TextBlock Grid.Column="2" Text="{Binding CodexLoginStatusText}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="不提供密码输入框——请直接使用 Codex CLI 完成登录。"
                                   Style="{StaticResource StatusLabel}" Margin="0,0,0,0" TextWrapping="Wrap" />
                        <Button Content="重新检测登录状态" Style="{StaticResource Style.SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding RefreshLoginStatusCommand}" />
                        <Expander Style="{StaticResource Style.Collapsible}" Margin="0,12,0,0">
                            <Expander.Header>
                                <TextBlock Text="高级" Style="{StaticResource AdvancedLabel}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="接口地址（留空使用默认）" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource EndpointBox}" Text="{Binding CodexEndpointOverride}" />
                                <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                           Text="{Binding EffectiveCodexUrl, StringFormat=当前使用：{0}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- MiniMax -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,10">
                <Expander Style="{StaticResource Style.Collapsible}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MiniMax" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <CheckBox Grid.Column="1" Content="显示" Margin="0,0,14,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ShowMiniMaxOnPanelCheckBox"
                                      ToolTip="取消勾选后该平台不在面板上显示（配置和数据都保留）"
                                      IsChecked="{Binding ShowMiniMaxOnPanel}" />
                            <TextBlock Grid.Column="2" Text="{Binding MiniMaxConfiguredText}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                    <TextBlock Text="区域" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton GroupName="MiniMaxRegion" Content="国内站"
                                     IsChecked="{Binding MiniMaxRegion, Converter={StaticResource EnumEquals}, ConverterParameter=China}" />
                        <RadioButton GroupName="MiniMaxRegion" Content="国际站"
                                     IsChecked="{Binding MiniMaxRegion, Converter={StaticResource EnumEquals}, ConverterParameter=International}" />
                    </StackPanel>

                    <!-- 统一 API Key 输入：未配置可直接输入；已配置默认掩码只读，点眼睛验证后显示明文并可编辑 -->
                    <Grid Margin="0,8,0,0">
                        <TextBox Style="{StaticResource SecretInputBox}"
                                 Text="{Binding MiniMaxKeyDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding MiniMaxKeyIsReadOnly}" />
                        <Button Style="{StaticResource EyeButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Content="&#128065;" Visibility="{Binding MiniMaxEyeVisibility}"
                                Command="{Binding ToggleRevealMiniMaxKeyCommand}"
                                ToolTip="验证身份后查看明文 Key" />
                    </Grid>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="默认显示掩码；点击眼睛并验证身份后可查看明文并编辑。保存后立即写入 Windows 凭据管理器。" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存 Key" Style="{StaticResource Style.PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding SaveMiniMaxKeyCommand}" />
                        <Button Content="清除 Key" Style="{StaticResource Style.SecondaryButton}"
                                Command="{Binding ClearMiniMaxKeyCommand}" />
                    </StackPanel>

                    <Expander Style="{StaticResource Style.Collapsible}" Margin="0,12,0,0">
                        <Expander.Header>
                            <TextBlock Text="高级" Style="{StaticResource AdvancedLabel}" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="接口地址（留空使用默认）" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource EndpointBox}" Text="{Binding MiniMaxEndpointOverride}" />
                            <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                       Text="{Binding EffectiveMiniMaxUrl, StringFormat=当前使用：{0}}" />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- DeepSeek -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,10">
                <Expander Style="{StaticResource Style.Collapsible}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DeepSeek" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <CheckBox Grid.Column="1" Content="显示" Margin="0,0,14,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ShowDeepSeekOnPanelCheckBox"
                                      ToolTip="取消勾选后该平台不在面板上显示（配置和数据都保留）"
                                      IsChecked="{Binding ShowDeepSeekOnPanel}" />
                            <TextBlock Grid.Column="2" Text="{Binding DeepSeekConfiguredText}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                    <!-- 统一 API Key 输入：未配置可直接输入；已配置默认掩码只读，点眼睛验证后显示明文并可编辑 -->
                    <Grid Margin="0,8,0,0">
                        <TextBox Style="{StaticResource SecretInputBox}"
                                 Text="{Binding DeepSeekKeyDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding DeepSeekKeyIsReadOnly}" />
                        <Button Style="{StaticResource EyeButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Content="&#128065;" Visibility="{Binding DeepSeekEyeVisibility}"
                                Command="{Binding ToggleRevealDeepSeekKeyCommand}"
                                ToolTip="验证身份后查看明文 Key" />
                    </Grid>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="默认显示掩码；点击眼睛并验证身份后可查看明文并编辑。保存后立即写入 Windows 凭据管理器。" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存 Key" Style="{StaticResource Style.PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding SaveDeepSeekKeyCommand}" />
                        <Button Content="清除 Key" Style="{StaticResource Style.SecondaryButton}"
                                Command="{Binding ClearDeepSeekKeyCommand}" />
                    </StackPanel>

                    <Expander Style="{StaticResource Style.Collapsible}" Margin="0,12,0,0">
                        <Expander.Header>
                            <TextBlock Text="高级" Style="{StaticResource AdvancedLabel}" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="接口地址（留空使用默认）" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource EndpointBox}" Text="{Binding DeepSeekEndpointOverride}" />
                            <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                       Text="{Binding EffectiveDeepSeekUrl, StringFormat=当前使用：{0}}" />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 阿里云百炼 Token Plan（个人版）：WebView2 一键登录 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,10">
                <Expander Style="{StaticResource Style.Collapsible}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阿里云百炼 Token Plan" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <CheckBox Grid.Column="1" Content="显示" Margin="0,0,14,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ShowTokenPlanOnPanelCheckBox"
                                      ToolTip="取消勾选后该平台不在面板上显示（配置和数据都保留）"
                                      IsChecked="{Binding ShowTokenPlanOnPanel}" />
                            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}">
                                <Run Text="{Binding TokenPlanConfiguredText, Mode=OneWay}" />
                                <Run Text=" · cn-beijing" FontFamily="Consolas" />
                            </TextBlock>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                    <TextBlock Style="{StaticResource StatusLabel}" Margin="0,0,0,0" TextWrapping="Wrap"
                               Text="点击「一键登录」会在内置浏览器窗口中登录阿里云百炼。登录成功后自动保存登录态并查询 Token Plan 个人版 7 天使用率与重置时间，无需手工复制任何内容。登录态安全存入 Windows 凭据管理器，不落盘、不写日志。" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="一键登录" Style="{StaticResource Style.PrimaryButton}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="LoginTokenPlanButton"
                                Command="{Binding LoginTokenPlanCommand}"
                                IsEnabled="{Binding IsTokenPlanLoggingIn, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Content="清除登录态" Style="{StaticResource Style.SecondaryButton}"
                                AutomationProperties.AutomationId="ClearTokenPlanButton"
                                Command="{Binding ClearTokenPlanCookieCommand}"
                                IsEnabled="{Binding IsTokenPlanConfigured}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="登录态失效后卡片会显示「需要重新登录」，回到这里点「一键登录」即可，无需重填任何信息。" />
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 自定义平台 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自定义平台" Style="{StaticResource SectionTitle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="OpenCode GO 模板" Style="{StaticResource Style.SecondaryButton}" Margin="0,0,6,0"
                                    AutomationProperties.AutomationId="AddOpenCodeGoTemplateButton"
                                    Command="{Binding AddOpenCodeGoTemplateCommand}" />
                            <Button Content="+ 添加自定义平台" Style="{StaticResource Style.SecondaryButton}"
                                    AutomationProperties.AutomationId="AddCustomPlatformButton"
                                    Command="{Binding AddCustomPlatformCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="除内置平台外，可手动添加其他额度接口。一个平台只发一次请求，可以从同一份返回里解析出多个额度窗口（如 5 小时/每周/每月），不用为每个窗口分别建平台。保存后立即显示在面板上，无需重启。" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,10,0,0" Text="还没有自定义平台，点击右上角“+ 添加自定义平台”试试，或直接用“OpenCode GO 模板”。"
                               Visibility="{Binding CustomPlatformsEmptyHintVisibility}" />
                    <ItemsControl x:Name="CustomPlatformsItemsControl" ItemsSource="{Binding CustomPlatformRows}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,6,0,0" Padding="10">
                                    <StackPanel>
                                        <!-- 收起态：名称 + 展开/删除 -->
                                        <Grid Visibility="{Binding HeaderVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Padding="8,6" FontSize="12" VerticalAlignment="Center"
                                                     AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomName_{0}}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="展开" Style="{StaticResource Style.SecondaryButton}"
                                                    Margin="0,0,6,0"
                                                    AutomationProperties.AutomationId="{Binding Id, StringFormat=ExpandCustom_{0}}"
                                                    Command="{Binding ToggleExpandCommand}" />
                                            <Button Grid.Column="2" Content="删除" Style="{StaticResource Style.SecondaryButton}"
                                                    AutomationProperties.AutomationId="{Binding Id, StringFormat=DeleteCustom_{0}}"
                                                    Command="{Binding DeleteCommand}" />
                                        </Grid>

                                        <!-- 展开态：完整编辑区 -->
                                        <StackPanel Visibility="{Binding EditorVisibility}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" />
                                                <Button Grid.Column="1" Content="收起" Style="{StaticResource Style.SecondaryButton}"
                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=CollapseCustom_{0}}"
                                                        Command="{Binding ToggleExpandCommand}" />
                                            </Grid>
                                            <TextBox Style="{StaticResource EndpointBox}"
                                                     AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomName_{0}}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                            <TextBox Style="{StaticResource EndpointBox}"
                                                     AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomEndpoint_{0}}"
                                                     Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                       Text="同一平台只请求这一个地址，下面所有窗口都从这一份返回里取值。" />

                                            <TextBlock Text="鉴权方式" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=AuthRadio_{0}_Bearer}"
                                                             GroupName="{Binding Id, StringFormat=Auth_{0}}" Content="Bearer Token"
                                                             IsChecked="{Binding AuthKind, Converter={StaticResource EnumEquals}, ConverterParameter=BearerKey}" />
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=AuthRadio_{0}_Header}"
                                                             GroupName="{Binding Id, StringFormat=Auth_{0}}" Content="自定义请求头"
                                                             IsChecked="{Binding AuthKind, Converter={StaticResource EnumEquals}, ConverterParameter=CustomHeader}" />
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=AuthRadio_{0}_None}"
                                                             GroupName="{Binding Id, StringFormat=Auth_{0}}" Content="无需鉴权"
                                                             IsChecked="{Binding AuthKind, Converter={StaticResource EnumEquals}, ConverterParameter=None}" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding HeaderNameVisibility}">
                                                <TextBlock Text="请求头名称（自定义请求头方式）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                <TextBox Style="{StaticResource EndpointBox}"
                                                         Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <!-- 密钥块（AuthKind != None 时显示） -->
                                            <StackPanel Visibility="{Binding KeyVisibility}" Margin="0,8,0,0">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SecretInputBox}"
                                                             AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomKey_{0}}"
                                                             Text="{Binding KeyDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding KeyIsReadOnly}" />
                                                    <Button Style="{StaticResource EyeButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Margin="0,0,4,0" Content="&#128065;" Visibility="{Binding KeyEyeVisibility}"
                                                            Command="{Binding ToggleRevealKeyCommand}" ToolTip="验证身份后查看明文 Key" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                           Text="默认显示掩码；点击眼睛并验证身份后可查看明文并编辑。保存后立即写入 Windows 凭据管理器。" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="保存 Key" Style="{StaticResource Style.PrimaryButton}" Margin="0,0,8,0"
                                                            AutomationProperties.AutomationId="{Binding Id, StringFormat=SaveCustomKey_{0}}"
                                                            Command="{Binding SaveKeyCommand}" />
                                                    <Button Content="清除 Key" Style="{StaticResource Style.SecondaryButton}"
                                                            Command="{Binding ClearKeyCommand}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 额度窗口列表：一次请求、多个窗口，各自可折叠 -->
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="额度窗口" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                                                <Button Grid.Column="1" Content="+ 添加窗口" Style="{StaticResource Style.SecondaryButton}"
                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=AddWindow_{0}}"
                                                        Command="{Binding AddWindowCommand}" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                       Text="至少保留一个窗口，最多 5 个；同一平台内窗口名称不能重复。" />

                                            <ItemsControl ItemsSource="{Binding QuotaWindowRows}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1"
                                                                CornerRadius="6" Margin="0,4,0,0" Padding="8">
                                                            <StackPanel>
                                                                <!-- 窗口收起态：名称 + 摘要 + 展开/删除 -->
                                                                <Grid Visibility="{Binding HeaderVisibility}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding SummaryText}" FontSize="11"
                                                                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="展开" Style="{StaticResource Style.SecondaryButton}"
                                                                            Margin="0,0,6,0"
                                                                            AutomationProperties.AutomationId="{Binding Id, StringFormat=ExpandWindow_{0}}"
                                                                            Command="{Binding ToggleExpandCommand}" />
                                                                    <Button Grid.Column="2" Content="删除" Style="{StaticResource Style.SecondaryButton}"
                                                                            AutomationProperties.AutomationId="{Binding Id, StringFormat=DeleteWindow_{0}}"
                                                                            Command="{Binding DeleteCommand}" />
                                                                </Grid>

                                                                <!-- 窗口展开态：完整编辑区 -->
                                                                <StackPanel Visibility="{Binding EditorVisibility}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="窗口名称" Style="{StaticResource FieldLabel}" />
                                                                        <Button Grid.Column="1" Content="收起" Style="{StaticResource Style.SecondaryButton}"
                                                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=CollapseWindow_{0}}"
                                                                                Command="{Binding ToggleExpandCommand}" />
                                                                    </Grid>
                                                                    <TextBox Style="{StaticResource EndpointBox}"
                                                                             AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowName_{0}}"
                                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                                                    <TextBlock Text="数据语义" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                                    <ComboBox Margin="0,4,0,0"
                                                                              AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowDataKind_{0}}"
                                                                              ItemsSource="{x:Static vm:CustomDataKindOption.All}"
                                                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                              SelectedValue="{Binding DataKind}" />

                                                                    <TextBlock Text="取值路径（JSON）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                                    <TextBox Style="{StaticResource EndpointBox}"
                                                                             AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowValuePath_{0}}"
                                                                             Text="{Binding ValuePath, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                                               Text="点号属性 + [n] 数组下标，例如 usage.rolling.percent、data.items[0].quota。路径配错只影响这一个窗口，其它窗口正常显示。" />

                                                                    <StackPanel Visibility="{Binding LimitVisibility}">
                                                                        <TextBlock Text="额度上限路径（可选，优先于固定上限）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                                        <TextBox Style="{StaticResource EndpointBox}"
                                                                                 AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowLimitPath_{0}}"
                                                                                 Text="{Binding LimitPath, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <TextBlock Text="固定额度上限（上限路径留空时用）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                                        <TextBox Style="{StaticResource EndpointBox}"
                                                                                 AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowFixedLimit_{0}}"
                                                                                 Text="{Binding FixedLimitText, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding UnitVisibility}">
                                                                        <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                                                        <TextBox Width="90" Padding="6,4"
                                                                                 AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowUnit_{0}}"
                                                                                 Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>

                                                                    <TextBlock Text="窗口重置时间路径（可选）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                                    <TextBox Style="{StaticResource EndpointBox}"
                                                                             AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowResetsAtPath_{0}}"
                                                                             Text="{Binding ResetsAtPath, UpdateSourceTrigger=PropertyChanged}" />

                                                                    <TextBlock Text="重置时间解析方式" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                                    <ComboBox Margin="0,4,0,0"
                                                                              AutomationProperties.AutomationId="{Binding Id, StringFormat=WindowResetKind_{0}}"
                                                                              ItemsSource="{x:Static vm:CustomResetTimeKindOption.All}"
                                                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                              SelectedValue="{Binding ResetTimeKind}" />
                                                                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                                               Text="自动识别/绝对时间支持 epoch 毫秒/秒数字或 ISO 时间字符串；剩余秒数按响应到达时刻换算。留空表示不显示重置时间。" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        </TabItem>
        <!-- ==================== 显示与窗口 ==================== -->
        <TabItem Header="显示与窗口">
        <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="显示与窗口" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource StatusLabel}" Margin="0,-10,0,14" TextWrapping="Wrap"
                       Text="本页所有设置均即时生效，不需要点底部的「保存设置」。" />

            <!-- 显示与窗口：这一整卡都是"改了立即生效"，不受下方"保存设置"按钮控制
                 （跟托盘图标固定/已用剩余切换是同一类即时设置），所以卡片内没有重复的保存按钮。 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>

                    <TextBlock Text="显示模式" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="托盘弹出" Style="{StaticResource Style.SecondaryButton}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="EnterTrayModeButton"
                                Command="{Binding EnterTrayModeCommand}" />
                        <Button Content="悬浮窗口" Style="{StaticResource Style.SecondaryButton}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="EnterFloatingModeButton"
                                Command="{Binding EnterFloatingModeCommand}" />
                        <Button Content="桌面看板" Style="{StaticResource Style.SecondaryButton}"
                                AutomationProperties.AutomationId="EnterDesktopPanelModeButton"
                                Command="{Binding EnterDesktopPanelModeCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap">
                        <Run Text="托盘弹出：点击托盘图标才出现，点外部自动收起（原有行为）。悬浮窗口/桌面看板：常驻显示、可拖动、点外部不收起，位置和大小按显示器分别记住。当前模式：" />
                        <Run Text="{Binding WindowMode, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>

                    <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,12,0,10" />

                    <CheckBox Content="始终置顶" IsChecked="{Binding WindowAlwaysOnTop, Mode=TwoWay}"
                              AutomationProperties.AutomationId="WindowAlwaysOnTopCheckBox" />
                    <TextBlock Style="{StaticResource StatusLabel}" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="仅对悬浮窗口/桌面看板生效；托盘弹出面板始终置顶，不受此项影响。" />

                    <CheckBox Content="锁定位置（锁定后不能拖动）" IsChecked="{Binding WindowPositionLocked, Mode=TwoWay}"
                               AutomationProperties.AutomationId="WindowPositionLockedCheckBox" Margin="0,0,0,8" />

                    <CheckBox Content="紧凑布局" IsChecked="{Binding WindowCompactLayout, Mode=TwoWay}"
                               AutomationProperties.AutomationId="WindowCompactLayoutCheckBox" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource StatusLabel}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="卡片内边距收窄，适合长期摆在桌面上、只需要一眼瞄一下额度的场景。" />

                    <CheckBox Content="拖动时吸附屏幕边缘" IsChecked="{Binding WindowSnapToEdges, Mode=TwoWay}" Margin="0,0,0,8" />

                    <CheckBox Content="启动后恢复上次使用的显示模式" IsChecked="{Binding WindowRestoreLastModeOnStartup, Mode=TwoWay}" Margin="0,0,0,8" />

                    <CheckBox Content="悬停时临时提高不透明度（便于查看）" IsChecked="{Binding WindowEnhanceReadabilityOnHover, Mode=TwoWay}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="不透明度（悬浮窗口/桌面看板）" Style="{StaticResource FieldLabel}" />
                            <Slider Minimum="0.7" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                    IsSnapToTickEnabled="True" TickFrequency="0.05" Margin="0,6,0,0"
                                    Value="{Binding WindowOpacity, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                   Text="{Binding WindowOpacity, StringFormat={}{0:P0}}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>

                    <TextBlock Text="背景材质" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton GroupName="WindowMaterial" Content="系统"
                                     IsChecked="{Binding WindowMaterial, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        <RadioButton GroupName="WindowMaterial" Content="云母"
                                     IsChecked="{Binding WindowMaterial, Converter={StaticResource EnumEquals}, ConverterParameter=Mica}" />
                        <RadioButton GroupName="WindowMaterial" Content="亚克力"
                                     IsChecked="{Binding WindowMaterial, Converter={StaticResource EnumEquals}, ConverterParameter=Acrylic}" />
                        <RadioButton GroupName="WindowMaterial" Content="纯色"
                                     IsChecked="{Binding WindowMaterial, Converter={StaticResource EnumEquals}, ConverterParameter=Solid}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="面板采用无边框自绘窗口以实现圆角和阴影，与 Windows 真实的云母/亚克力合成效果存在架构性冲突（详见 README「已知风险」），云母/亚克力在此显示为对应色调的半透明背景近似，而非系统级材质渲染。" />
                    <TextBlock Style="{StaticResource StatusLabel}" Foreground="{DynamicResource Brush.AccentDeepSeek}"
                               Visibility="{Binding IsMaterialFullySupported, Converter={StaticResource InverseBoolToVis}}"
                               Text="当前系统版本/会话不满足 DWM 系统材质要求（需 Windows 11 22621+，且非远程桌面、非高对比度），以下材质选项均按纯色近似渲染。" />

                    <Button Content="恢复默认窗口位置" Style="{StaticResource Style.SecondaryButton}" Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="RestoreDefaultWindowPositionButton"
                            Command="{Binding RestoreDefaultWindowPositionCommand}"
                            ToolTip="把当前模式（悬浮窗口/桌面看板）的位置和大小重置为推荐默认值" />
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        </TabItem>

        <!-- ==================== 快捷键 ==================== -->
        <TabItem Header="快捷键">
        <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="快捷键" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox Content="启用显示/隐藏面板快捷键" IsChecked="{Binding HotkeyEnabled}" />
                    <TextBlock Text="组合键" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                    <TextBox x:Name="HotkeyCaptureBox" Style="{StaticResource EndpointBox}" IsReadOnly="True"
                             Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                             AutomationProperties.AutomationId="HotkeyCaptureBox"
                             Cursor="Hand" HorizontalContentAlignment="Center"
                             ToolTip="点击后按下想要的组合键（至少包含一个 Alt/Ctrl/Shift/Win）"
                             PreviewKeyDown="OnHotkeyCapturePreviewKeyDown" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="默认 Alt+Z。点击上面的框后直接按下新组合键即可修改，保存设置后生效；如果被其它程序占用会在保存后提示注册失败。" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
        </TabItem>

        <!-- ==================== 数据与隐私 ==================== -->
        <TabItem Header="数据与隐私">
        <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="数据与隐私" Style="{StaticResource PageTitle}" />

            <!-- 数据与隐私 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="配置目录" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource EndpointBox}" IsReadOnly="True"
                             AutomationProperties.AutomationId="DataDirectoryBox"
                             Text="{Binding DataDirectory, Mode=OneWay}"
                             ToolTip="设置、额度缓存与崩溃日志都在这个目录下" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="settings.json（DPAPI 加密）、cache.json、crash.log 都在这里。设置文件按当前 Windows 用户加密，换用户或换机器无法解密——因此把它放到程序目录也不会变成绿色软件，密钥和登录态更是保存在凭据管理器里、根本不在文件中。" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="打开配置目录" Style="{StaticResource Style.SecondaryButton}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="OpenDataDirectoryButton"
                                Command="{Binding OpenDataDirectoryCommand}" />
                        <Button Content="清除本地缓存" Style="{StaticResource Style.SecondaryButton}"
                                AutomationProperties.AutomationId="ClearCacheButton"
                                Command="{Binding ClearCacheCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="密钥保存在 Windows 凭据管理器中，不会写入普通配置文件、日志或缓存。Claude/Codex 的登录状态直接读取对应 CLI 本机凭据文件，QuotaFlow 不存储、也不上传这些凭据。" />
                </StackPanel>
            </Border>

            <!-- 跨设备迁移 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="备份与迁移" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource StatusLabel}" Margin="0,0,0,0" TextWrapping="Wrap"
                               Text="导出一个加密备份包，在另一台设备上导入即可，无需逐项重填。包含所有偏好设置、自定义平台定义，以及 MiniMax / DeepSeek / 自定义平台的 API Key 和百炼登录态。" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.StatusWarn}"
                               Text="导出会先验证身份（与查看 API Key 明文同一机制），因为备份包含全部密钥。请用足够强的口令并妥善保管文件——口令不会被保存，忘记后无法找回、备份包也就再也打不开。Claude / Codex 无需迁移，它们的登录态由各自的 CLI 管理，在新设备上登录一次 CLI 即可。" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="导出备份…" Style="{StaticResource Style.SecondaryButton}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="ExportBackupButton"
                                Command="{Binding ExportBackupCommand}" />
                        <Button Content="导入备份…" Style="{StaticResource Style.SecondaryButton}"
                                AutomationProperties.AutomationId="ImportBackupButton"
                                Command="{Binding ImportBackupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        </TabItem>

        <!-- ==================== 关于 ==================== -->
        <TabItem Header="关于">
        <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="关于" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"
                               Text="{Binding AppVersionText}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="Claude/Codex/MiniMax 额度查询的接口路径参考了 cc-switch（MIT License，https://github.com/farion1231/cc-switch）并结合本机实测确认。详见项目 README 的“已知风险与致谢”一节。" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
        </TabItem>

        </TabControl>
    </DockPanel>
</Window>
