<Window x:Class="QuotaFlow.Windows.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuotaFlow.Windows.App.Converters"
        Title="QuotaFlow 设置" Width="440" Height="720" MinWidth="400" MinHeight="480"
        Background="{DynamicResource Brush.Background}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Divider}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EndpointBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="SecretInputBox" TargetType="TextBox">
            <!-- 右侧留出 34px 给叠加的"眼睛"按钮 -->
            <Setter Property="Padding" Value="8,6,34,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <!-- API Key 只会是 ASCII 字符，禁用输入法：既不需要中文候选框，也避免第三方 IME 钩子冲突。 -->
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
        </Style>
    </Window.Resources>

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 刷新 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="刷新" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自动刷新间隔" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" Width="120" ItemsSource="{Binding AllowedRefreshIntervals}"
                                  SelectedItem="{Binding AutoRefreshIntervalMinutes}" />
                    </Grid>
                    <CheckBox Content="启动时立即刷新" IsChecked="{Binding RefreshOnStartup}" />
                </StackPanel>
            </Border>

            <!-- 启动 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="开机自动启动（默认关闭）" IsChecked="{Binding StartWithWindows}" />
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Theme" Content="跟随系统"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        <RadioButton GroupName="Theme" Content="浅色"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                        <RadioButton GroupName="Theme" Content="深色"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                    </StackPanel>
                    <TextBlock Text="日期显示格式" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ClockDisplayFormatOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Format"
                              SelectedValue="{Binding ClockDisplayFormat}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="下拉中的每个选项都展示该格式的实时效果，选项含义一目了然，选中后立即应用到面板顶部的时钟。" />
                </StackPanel>
            </Border>

            <!-- 额度窗口显示 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="额度窗口显示" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="显示未识别的新额度窗口（默认关闭）" IsChecked="{Binding ShowUnknownWindows}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="服务端偶尔会新增尚未识别的额度窗口（例如 nimbus_quill）。默认隐藏，不占面板空间；开启后这类窗口会以中文标签显示出来，便于观察。" />
                </StackPanel>
            </Border>

            <!-- Claude -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Claude" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Content="重新检测" Style="{StaticResource Style.SecondaryButton}"
                                Command="{Binding RefreshLoginStatusCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ClaudeLoginStatusText}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0" />
                    <TextBlock Text="不提供密码输入框——请直接使用 Claude Code CLI 完成登录。"
                               Style="{StaticResource StatusLabel}" TextWrapping="Wrap" />
                    <TextBlock Text="接口地址（可选）" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                    <TextBox Style="{StaticResource EndpointBox}" Text="{Binding ClaudeEndpointOverride}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="{Binding EffectiveClaudeUrl, StringFormat=当前使用：{0}}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="留空使用内置默认地址，仅地址变更时填写。保存设置后立即生效。" />
                </StackPanel>
            </Border>

            <!-- Codex -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Codex" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Content="重新检测" Style="{StaticResource Style.SecondaryButton}"
                                Command="{Binding RefreshLoginStatusCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding CodexLoginStatusText}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0" />
                    <TextBlock Text="不提供密码输入框——请直接使用 Codex CLI 完成登录。"
                               Style="{StaticResource StatusLabel}" TextWrapping="Wrap" />
                    <TextBlock Text="接口地址（可选）" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                    <TextBox Style="{StaticResource EndpointBox}" Text="{Binding CodexEndpointOverride}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="{Binding EffectiveCodexUrl, StringFormat=当前使用：{0}}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="留空使用内置默认地址，仅地址变更时填写。保存设置后立即生效。" />
                </StackPanel>
            </Border>

            <!-- MiniMax -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MiniMax" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Column="1" Text="{Binding MiniMaxConfiguredText}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton GroupName="MiniMaxRegion" Content="国内站"
                                     IsChecked="{Binding MiniMaxRegion, Converter={StaticResource EnumEquals}, ConverterParameter=China}" />
                        <RadioButton GroupName="MiniMaxRegion" Content="国际站"
                                     IsChecked="{Binding MiniMaxRegion, Converter={StaticResource EnumEquals}, ConverterParameter=International}" />
                    </StackPanel>

                    <!-- 统一 API Key 输入：未配置可直接输入；已配置默认掩码只读，点眼睛验证后显示明文并可编辑 -->
                    <Grid Margin="0,8,0,0">
                        <TextBox Style="{StaticResource SecretInputBox}"
                                 Text="{Binding MiniMaxKeyDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding MiniMaxKeyIsReadOnly}" />
                        <Button Style="{StaticResource EyeButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Content="&#128065;" Visibility="{Binding MiniMaxEyeVisibility}"
                                Command="{Binding ToggleRevealMiniMaxKeyCommand}"
                                ToolTip="验证身份后查看明文 Key" />
                    </Grid>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="默认显示掩码；点击眼睛并验证身份后可查看明文并编辑。保存后立即写入 Windows 凭据管理器。" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存 Key" Style="{StaticResource Style.PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding SaveMiniMaxKeyCommand}" />
                        <Button Content="清除 Key" Style="{StaticResource Style.SecondaryButton}"
                                Command="{Binding ClearMiniMaxKeyCommand}" />
                    </StackPanel>

                    <TextBlock Text="接口地址（可选）" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    <TextBox Style="{StaticResource EndpointBox}" Text="{Binding MiniMaxEndpointOverride}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="{Binding EffectiveMiniMaxUrl, StringFormat=当前使用：{0}}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="留空使用内置默认地址，仅地址变更时填写。保存设置后立即生效。" />
                </StackPanel>
            </Border>

            <!-- DeepSeek -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DeepSeek" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Column="1" Text="{Binding DeepSeekConfiguredText}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>

                    <!-- 统一 API Key 输入：未配置可直接输入；已配置默认掩码只读，点眼睛验证后显示明文并可编辑 -->
                    <Grid Margin="0,8,0,0">
                        <TextBox Style="{StaticResource SecretInputBox}"
                                 Text="{Binding DeepSeekKeyDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding DeepSeekKeyIsReadOnly}" />
                        <Button Style="{StaticResource EyeButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Content="&#128065;" Visibility="{Binding DeepSeekEyeVisibility}"
                                Command="{Binding ToggleRevealDeepSeekKeyCommand}"
                                ToolTip="验证身份后查看明文 Key" />
                    </Grid>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="默认显示掩码；点击眼睛并验证身份后可查看明文并编辑。保存后立即写入 Windows 凭据管理器。" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存 Key" Style="{StaticResource Style.PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding SaveDeepSeekKeyCommand}" />
                        <Button Content="清除 Key" Style="{StaticResource Style.SecondaryButton}"
                                Command="{Binding ClearDeepSeekKeyCommand}" />
                    </StackPanel>

                    <TextBlock Text="接口地址（可选）" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    <TextBox Style="{StaticResource EndpointBox}" Text="{Binding DeepSeekEndpointOverride}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="{Binding EffectiveDeepSeekUrl, StringFormat=当前使用：{0}}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="留空使用内置默认地址，仅地址变更时填写。保存设置后立即生效。" />
                </StackPanel>
            </Border>

            <!-- 自定义平台 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自定义平台" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Content="+ 添加自定义平台" Style="{StaticResource Style.SecondaryButton}"
                                AutomationProperties.AutomationId="AddCustomPlatformButton"
                                Command="{Binding AddCustomPlatformCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="除内置平台外，可手动添加其他额度接口（如 OpenCode / GO）。保存后立即显示在面板上，无需重启。" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Margin="0,10,0,0" Text="还没有自定义平台，点击右上角“+ 添加自定义平台”试试。"
                               Visibility="{Binding CustomPlatformsEmptyHintVisibility}" />
                    <ItemsControl x:Name="CustomPlatformsItemsControl" ItemsSource="{Binding CustomPlatformRows}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,6,0,0" Padding="10">
                                    <StackPanel>
                                        <!-- 收起态：名称 + 展开/删除 -->
                                        <Grid Visibility="{Binding HeaderVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Padding="8,6" FontSize="12" VerticalAlignment="Center"
                                                     AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomName_{0}}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="展开" Style="{StaticResource Style.SecondaryButton}"
                                                    Margin="0,0,6,0"
                                                    AutomationProperties.AutomationId="{Binding Id, StringFormat=ExpandCustom_{0}}"
                                                    Command="{Binding ToggleExpandCommand}" />
                                            <Button Grid.Column="2" Content="删除" Style="{StaticResource Style.SecondaryButton}"
                                                    AutomationProperties.AutomationId="{Binding Id, StringFormat=DeleteCustom_{0}}"
                                                    Command="{Binding DeleteCommand}" />
                                        </Grid>

                                        <!-- 展开态：完整编辑区 -->
                                        <StackPanel Visibility="{Binding EditorVisibility}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" />
                                                <Button Grid.Column="1" Content="收起" Style="{StaticResource Style.SecondaryButton}"
                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=CollapseCustom_{0}}"
                                                        Command="{Binding ToggleExpandCommand}" />
                                            </Grid>
                                            <TextBox Style="{StaticResource EndpointBox}"
                                                     AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomName_{0}}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                            <TextBox Style="{StaticResource EndpointBox}"
                                                     AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomEndpoint_{0}}"
                                                     Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="鉴权方式" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=AuthRadio_{0}_Bearer}"
                                                             GroupName="{Binding Id, StringFormat=Auth_{0}}" Content="Bearer Token"
                                                             IsChecked="{Binding AuthKind, Converter={StaticResource EnumEquals}, ConverterParameter=BearerKey}" />
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=AuthRadio_{0}_Header}"
                                                             GroupName="{Binding Id, StringFormat=Auth_{0}}" Content="自定义请求头"
                                                             IsChecked="{Binding AuthKind, Converter={StaticResource EnumEquals}, ConverterParameter=CustomHeader}" />
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=AuthRadio_{0}_None}"
                                                             GroupName="{Binding Id, StringFormat=Auth_{0}}" Content="无需鉴权"
                                                             IsChecked="{Binding AuthKind, Converter={StaticResource EnumEquals}, ConverterParameter=None}" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding HeaderNameVisibility}">
                                                <TextBlock Text="请求头名称（自定义请求头方式）" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                                <TextBox Style="{StaticResource EndpointBox}"
                                                         Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <!-- 密钥块（AuthKind != None 时显示） -->
                                            <StackPanel Visibility="{Binding KeyVisibility}" Margin="0,8,0,0">
                                                <Grid>
                                                    <TextBox Style="{StaticResource SecretInputBox}"
                                                             AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomKey_{0}}"
                                                             Text="{Binding KeyDisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding KeyIsReadOnly}" />
                                                    <Button Style="{StaticResource EyeButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Margin="0,0,4,0" Content="&#128065;" Visibility="{Binding KeyEyeVisibility}"
                                                            Command="{Binding ToggleRevealKeyCommand}" ToolTip="验证身份后查看明文 Key" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                           Text="默认显示掩码；点击眼睛并验证身份后可查看明文并编辑。保存后立即写入 Windows 凭据管理器。" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="保存 Key" Style="{StaticResource Style.PrimaryButton}" Margin="0,0,8,0"
                                                            AutomationProperties.AutomationId="{Binding Id, StringFormat=SaveCustomKey_{0}}"
                                                            Command="{Binding SaveKeyCommand}" />
                                                    <Button Content="清除 Key" Style="{StaticResource Style.SecondaryButton}"
                                                            Command="{Binding ClearKeyCommand}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="数据语义" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=DataRadio_{0}_Utilization}"
                                                             GroupName="{Binding Id, StringFormat=Data_{0}}" Content="已使用百分比"
                                                             IsChecked="{Binding DataKind, Converter={StaticResource EnumEquals}, ConverterParameter=UtilizationPercent}" />
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=DataRadio_{0}_Remaining}"
                                                             GroupName="{Binding Id, StringFormat=Data_{0}}" Content="剩余百分比"
                                                             IsChecked="{Binding DataKind, Converter={StaticResource EnumEquals}, ConverterParameter=RemainingPercent}" />
                                                <RadioButton AutomationProperties.AutomationId="{Binding Id, StringFormat=DataRadio_{0}_Balance}"
                                                             GroupName="{Binding Id, StringFormat=Data_{0}}" Content="余额"
                                                             IsChecked="{Binding DataKind, Converter={StaticResource EnumEquals}, ConverterParameter=Balance}" />
                                            </StackPanel>

                                            <TextBlock Text="取值路径（JSON）" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                            <TextBox Style="{StaticResource EndpointBox}"
                                                     AutomationProperties.AutomationId="{Binding Id, StringFormat=CustomValuePath_{0}}"
                                                     Text="{Binding ValuePath, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                       Text="点号属性 + [n] 数组下标，例如 data.usage_percent、data.items[0].quota。路径配错会在面板显示错误卡片，而不会显示成 0%。" />

                                            <TextBlock Text="窗口重置时间路径（可选）" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                            <TextBox Style="{StaticResource EndpointBox}"
                                                     Text="{Binding ResetsAtPath, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                                                       Text="支持 epoch 毫秒/秒数字或 ISO 时间字符串；留空表示不显示重置时间。" />

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding CurrencyVisibility}">
                                                <TextBlock Text="币种" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                                <TextBox Width="80" Padding="6,4" Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 数据与隐私 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="数据与隐私" Style="{StaticResource SectionTitle}" />
                    <Button Content="清除本地缓存" Style="{StaticResource Style.SecondaryButton}" HorizontalAlignment="Left"
                            Command="{Binding ClearCacheCommand}" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="密钥保存在 Windows 凭据管理器中，不会写入普通配置文件、日志或缓存。Claude/Codex 的登录状态直接读取对应 CLI 本机凭据文件，QuotaFlow 不存储、也不上传这些凭据。" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}"
                               Text="{Binding AppVersionText}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource StatusLabel}" TextWrapping="Wrap"
                               Text="Claude/Codex/MiniMax 额度查询的接口路径参考了 cc-switch（MIT License，https://github.com/farion1231/cc-switch）并结合本机实测确认。详见项目 README 的“已知风险与致谢”一节。" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" Margin="0,4,0,10"
                       AutomationProperties.AutomationId="StatusMessageText"
                       FontSize="12" Foreground="{DynamicResource Brush.AccentDeepSeek}" />

            <Button Content="保存设置" Style="{StaticResource Style.PrimaryButton}" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="SaveSettingsButton"
                    Command="{Binding SaveGeneralSettingsCommand}" Margin="0,0,0,20" />
        </StackPanel>
    </ScrollViewer>
</Window>
