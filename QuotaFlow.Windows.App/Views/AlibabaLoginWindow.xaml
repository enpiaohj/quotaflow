<Window x:Class="QuotaFlow.Windows.App.Views.AlibabaLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录阿里云百炼" Width="900" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}">

    <DockPanel>
        <!-- 顶部提示条：说明登录完成会自动关闭本窗口并开始查询额度。
             文案要说清"就在下面这个页面里登录"——这个窗口用的是应用独立的浏览器数据目录，
             跟系统 Edge/Chrome 的登录状态天然隔离，用户在别处登录过并不会自动带进来。 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Divider}" Padding="12,8">
            <StackPanel>
                <TextBlock Text="请在下方页面中登录你的阿里云账号。本窗口使用独立的浏览器数据，不会共享你在 Edge/Chrome 里的登录状态，首次使用需要在这里登录一次。"
                           FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusHint" Text="等待登录…" Margin="0,4,0,0"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 底部取消条：注意必须放在 Grid 之前——DockPanel 里只有最后一个子元素才填充剩余空间，
             如果 Grid 不是最后一个，它会被默认按 Dock.Left 只给内容宽度（实测 WebView2 只有 166px，
             百炼控制台据此判定"移动端视口"而拒绝显示桌面版）。 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Style.SecondaryButton}"
                        Click="OnCancelClick" />
            </StackPanel>
        </Border>

        <!-- 登录 WebView：作为 DockPanel 最后一个子元素填充剩余空间，确保以桌面宽度渲染 -->
        <Grid>
            <wv2:WebView2 x:Name="LoginWebView" />
            <TextBlock x:Name="LoadingHint" Text="正在加载阿里云百炼控制台…"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}" />
        </Grid>
    </DockPanel>
</Window>
