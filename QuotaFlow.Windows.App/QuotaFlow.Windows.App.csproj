<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QuotaFlow.Windows.Core\QuotaFlow.Windows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- app.ico 只用于 ApplicationIcon（exe 的 Win32 图标资源），不要在 XAML 里用 Icon="Assets/app.ico"
         引用它——WPF 的 IconBitmapDecoder 对多尺寸 ICO 容器很挑剔，实测会在 InitializeComponent()
         阶段抛 XamlParseException（哪怕已经把它声明成 Resource）。窗口标题栏图标改用下面这张
         单尺寸 PNG，走的是更稳定的 BitmapImage 解码路径。 -->
    <Resource Include="Assets\app_icon.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 升级到带 Windows SDK 投影的 TFM，仅为了调用 Windows.Security.Credentials.UI（Windows Hello）。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 只为了 NotifyIcon（系统托盘图标），不引入 WinForms 的 UI 表面。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>QuotaFlow</AssemblyName>
    <RootNamespace>QuotaFlow.Windows.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.4.7</Version>
    <Product>QuotaFlow</Product>
    <Company>QuotaFlow</Company>
  </PropertyGroup>

</Project>
